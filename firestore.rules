rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ==========================================
    // --- agora-debates subproject (Agora Debates) ---
    // ==========================================
    
    // Users
    match /agora-debates_users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId 
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['badges', 'role']));
      allow delete: if false;
    }

    // Debates (Topics)
    match /agora-debates_debates/{debateId} {
      allow read: if true;
      allow create: if request.auth != null 
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.isLocked == false
        && request.resource.data.expirationTime > request.time;
      allow update: if request.auth != null && (
        resource.data.creatorId == request.auth.uid || 
        get(/databases/$(database)/documents/agora-debates_users/$(request.auth.uid)).data.role == 'moderator'
      );
      allow delete: if false;
    }

    // Arguments
    match /agora-debates_debates/{debateId}/arguments/{argumentId} {
      allow read: if true;
      allow create: if request.auth != null 
        && request.resource.data.authorId == request.auth.uid
        && exists(/databases/$(database)/documents/agora-debates_debates/$(debateId))
        && get(/databases/$(database)/documents/agora-debates_debates/$(debateId)).data.isLocked == false
        && get(/databases/$(database)/documents/agora-debates_debates/$(debateId)).data.expirationTime > request.time;
      allow update: if request.auth != null && (
        (resource.data.authorId == request.auth.uid && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['upvotes', 'downvotes', 'consensusMetric']))) || 
        get(/databases/$(database)/documents/agora-debates_users/$(request.auth.uid)).data.role == 'moderator'
      );
      allow delete: if false;
    }

    // Rebuttals
    match /agora-debates_debates/{debateId}/arguments/{argumentId}/rebuttals/{rebuttalId} {
      allow read: if true;
      allow create: if request.auth != null 
        && request.resource.data.authorId == request.auth.uid
        && exists(/databases/$(database)/documents/agora-debates_debates/$(debateId))
        && get(/databases/$(database)/documents/agora-debates_debates/$(debateId)).data.isLocked == false
        && get(/databases/$(database)/documents/agora-debates_debates/$(debateId)).data.expirationTime > request.time;
      allow update: if request.auth != null && (
        (resource.data.authorId == request.auth.uid && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['upvotes', 'downvotes', 'consensusMetric']))) || 
        get(/databases/$(database)/documents/agora-debates_users/$(request.auth.uid)).data.role == 'moderator'
      );
      allow delete: if false;
    }

    // Votes subcollections
    match /agora-debates_debates/{debateId}/arguments/{argumentId}/votes/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    match /agora-debates_debates/{debateId}/arguments/{argumentId}/rebuttals/{rebuttalId}/votes/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ==========================================
    // --- habit-quest subproject ---
    // ==========================================
    match /habit-quest_users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /habit-quest_parties/{partyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.memberUids ||
        request.auth.uid in request.resource.data.memberUids
      );
      allow delete: if false;
    }

    match /habit-quest_partyBosses/{partyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    match /habit-quest_habits/{habitId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // --- wayfarer-hub subproject ---
    // ==========================================
    match /wayfarer-hub_users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /wayfarer-hub_trips/{tripId} {
      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.members ||
        request.auth.token.email in resource.data.invitedEmails
      );
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.members ||
        request.auth.token.email in resource.data.invitedEmails
      );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /wayfarer-hub_presence/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /wayfarer-hub_chats/{chatId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ==========================================
    // --- beat-weaver subproject ---
    // ==========================================
    match /beat-weaver_users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /beat-weaver_rooms/{roomId} {
      allow read, write: if true;
    }

    // ==========================================
    // --- guild-tactics subproject ---
    // ==========================================
    match /guild-tactics_users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['accent', 'cosmetics', 'displayName']);
      allow delete: if false;
    }

    match /guild-tactics_queue/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null;
    }

    match /guild-tactics_games/{gameId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.playerIds;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.playerIds
        && request.resource.data.playerIds.size() == 2;
      allow update: if false;
      allow delete: if false;
    }

    // ==========================================
    // --- thriftflip subproject ---
    // ==========================================
    match /thriftflip_users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /thriftflip_auctions/{auctionId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.seller_id == request.auth.uid;
      allow update: if request.auth != null && resource.data.seller_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.seller_id == request.auth.uid;

      match /bids/{bidId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.bidder_id == request.auth.uid
          && request.resource.data.auction_id == auctionId
          && exists(/databases/$(database)/documents/thriftflip_auctions/$(auctionId))
          && get(/databases/$(database)/documents/thriftflip_auctions/$(auctionId)).data.status == 'active'
          && request.resource.data.amount > get(/databases/$(database)/documents/thriftflip_auctions/$(auctionId)).data.current_price;
        allow update: if false;
        allow delete: if false;
      }
    }

    match /thriftflip_transactions/{transactionId} {
      allow read: if request.auth != null && (
        resource.data.buyer_id == request.auth.uid ||
        resource.data.seller_id == request.auth.uid
      );
      allow write: if false;
    }

    // ==========================================
    // --- neon-tetris-3d subproject ---
    // ==========================================
    match /neon-tetris-3d_users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /neon-tetris-3d_leaderboard/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['playerName', 'score', 'level', 'linesCleared']);
      allow update, delete: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
